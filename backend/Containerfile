FROM docker.io/library/node:22-alpine

# Necesario para el respaldo de la base de datos (pg_dump)
RUN apk add --no-cache postgresql17-client

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

RUN mkdir -p /app/uploads && chown -R node:node /app/uploads
USER node

EXPOSE 3000
CMD ["npm", "start"]